msgstr ""

#: build-src/code/structure.md:25
msgid "`exchange`: archiving and diffusion of the document units."
msgstr ""

#: build-src/code/structure.md:26
msgid ""
"`sample`: Module managing the sample mode of digitalized documents. (No "
"reason of being a separated module refactor needed)."
msgstr ""

#: build-src/code/structure.md:27
msgid ""
"`check`: Module managing automatic checks (Not triggered or performed by "
"users)."
msgstr ""

#: build-src/code/structure.md:28
msgid "`help`: Module managing the help page content."
msgstr ""

#: build-src/code/structure.md:29
msgid "`imagemetadata`:"
msgstr ""

#: build-src/code/structure.md:30
